<!doctype html>
<html lang="en" class="wa-theme-default wa-palette-default">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    // Picks light or dark before first paint, so a dark page never flashes
    // light. applyScheme in lib/scheme.js has the same rule; keep in step.
    (function () {
      var pref;
      try { pref = localStorage.getItem('scheme'); } catch (e) {}
      var dark = pref === 'dark'
        || (pref !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.add(dark ? 'wa-dark' : 'wa-light');
    })();
  </script>
  <title>{% if capture %}{{ title }} · {{ capture.title }}{% else %}{{ title }}{% endif %}</title>
  <link rel="stylesheet" href="/wa/styles/webawesome.css">
  <style>
    html, body { min-height: 100%; padding: 0; margin: 0; }
    wa-page { --menu-width: 16rem; }
    wa-page[view='mobile'] { --menu-width: auto; }

    .site-name { font-weight: var(--wa-font-weight-bold); text-decoration: none; }
    [slot='navigation'] nav a { text-decoration: none; }
    [slot='navigation'] nav a[aria-current='page'] { font-weight: var(--wa-font-weight-bold); }
    .details dt { font-size: var(--wa-font-size-s); color: var(--wa-color-text-quiet); }
    .details dd { margin: 0; }

    /* Light, dark, auto: three native radios drawn as one segmented control.
       Native rather than wa-radio-group or wa-dropdown, which would add to
       the bundle for what a fieldset already does. */
    .scheme-switch {
      display: flex;
      gap: 2px;
      margin: 0;
      padding: 2px;
      border: none;
      border-radius: var(--wa-border-radius-pill);
      background: var(--wa-color-neutral-fill-quiet);
    }
    .scheme-switch label {
      display: grid;
      place-items: center;
      inline-size: 2rem;
      block-size: 1.75rem;
      border-radius: var(--wa-border-radius-pill);
      color: var(--wa-color-text-quiet);
      cursor: pointer;
    }
    .scheme-switch label:has(:checked) {
      background: var(--wa-color-surface-default);
      color: var(--wa-color-text-normal);
      box-shadow: var(--wa-shadow-s);
    }
    .scheme-switch label:has(:focus-visible) { outline: var(--wa-focus-ring); }

    /* For the no-JS view: until app-echart upgrades, it is an unknown inline
       element holding the build's SVG. */
    app-echart:not(:defined) { display: block; margin-block: var(--wa-space-l); }
    app-echart:not(:defined) > svg { display: block; width: 100%; height: auto; }

    /* A tooltip's text is in the HTML for anyone reading the source; with JS
       off it would otherwise spill inline next to what it describes. */
    wa-tooltip:not(:defined) { display: none; }

    /* Dashboard pages (dashboard.liquid). Cards sit on a tray and are told
       apart by surface color alone: no borders, no shadows. Everything here
       is content, so it is plain HTML and CSS and looks the same with JS off;
       only the info tooltips and the charts' canvas need scripts. */
    .dashboard {
      & > p { max-inline-size: 65ch; }
      .stats { --min-column-size: 14ch; }
      .stats dt { color: var(--wa-color-text-quiet); }
      .tray {
        --min-column-size: 30ch;
        padding: var(--wa-space-xs);
        border-radius: var(--wa-border-radius-l);
        background: var(--wa-color-surface-lowered);
      }
      .card {
        padding: var(--wa-space-l);
        border-radius: var(--wa-border-radius-m);
        background: var(--wa-color-surface-default);
      }
      .card wa-icon { color: var(--wa-color-text-quiet); }
      .card app-echart, .card app-echart:not(:defined) { margin-block: 0; }
      /* No wrap: a long key squeezes itself rather than pushing the link to
         a line of its own. */
      .card-foot {
        flex-wrap: nowrap;
        align-items: baseline;
        margin-block-start: auto;
        color: var(--wa-color-text-quiet);
      }

      /* A share of a whole: one bar split by count, and a row per part. */
      .bar {
        display: flex;
        gap: 2px;
        block-size: 1.25rem;
        border-radius: var(--wa-border-radius-s);
        overflow: hidden;
        font-size: var(--wa-font-size-2xs);
        font-weight: var(--wa-font-weight-semibold);
      }
      .bar > span { display: grid; place-items: center; min-inline-size: 3px; }
      .rows { list-style: none; margin: 0; padding: 0; }
      .rows li {
        display: flex;
        align-items: center;
        gap: var(--wa-space-xs);
        margin: 0;   /* Web Awesome's native li indent */
        padding-block: var(--wa-space-xs);
        border-block-start: var(--wa-border-width-s) solid var(--wa-color-surface-border);
      }
      .rows li > :last-child { margin-inline-start: auto; font-variant-numeric: tabular-nums; }
      .dot { inline-size: 0.625rem; block-size: 0.625rem; border-radius: 2px; }
      .success { background: var(--wa-color-success-fill-loud); color: var(--wa-color-success-on-loud); }
      /* The same gray the card charts use for what is compared against. */
      .neutral { background: var(--wa-color-gray-60); }
      .danger { background: var(--wa-color-danger-fill-loud); }
    }
  </style>
  <script type="module" src="/assets/app.js"></script>
</head>
<body>
<wa-page mobile-breakpoint="920">
  <header slot="header" class="wa-split">
    <a class="site-name" href="/">chartdown</a>
    <fieldset id="scheme-switch" class="scheme-switch">
      <legend class="wa-visually-hidden">Color scheme</legend>
      <label id="scheme-light"><input class="wa-visually-hidden" type="radio" name="scheme" value="light"><wa-icon name="sun" label="Light"></wa-icon></label>
      <label id="scheme-dark"><input class="wa-visually-hidden" type="radio" name="scheme" value="dark"><wa-icon name="moon" label="Dark"></wa-icon></label>
      <label id="scheme-auto"><input class="wa-visually-hidden" type="radio" name="scheme" value="auto" checked><wa-icon name="circle-half-stroke" label="Auto"></wa-icon></label>
      <wa-tooltip for="scheme-light">Light</wa-tooltip>
      <wa-tooltip for="scheme-dark">Dark</wa-tooltip>
      <wa-tooltip for="scheme-auto">Auto: follows your system</wa-tooltip>
    </fieldset>
  </header>

{%- if capture %}
  <div slot="navigation-header" class="wa-stack wa-gap-3xs">
    <span class="wa-caption-s">Capture</span>
    <strong>{{ capture.title }}</strong>
  </div>
  <div slot="navigation" class="wa-stack wa-gap-l">
    <nav class="wa-stack wa-gap-xs">
    {%- for view in collections.views %}{% if view.data.capture.id == capture.id %}
      <a href="{{ view.url }}" data-drawer="close"{% if view.url == page.url %} aria-current="page"{% endif %}>{{ view.data.title }}</a>
    {%- endif %}{% endfor %}
    </nav>
    <wa-divider></wa-divider>
    <dl class="details wa-stack wa-gap-xs">
    {%- for d in capture.details %}
      <div><dt>{{ d[0] }}</dt><dd>{{ d[1] }}</dd></div>
    {%- endfor %}
    </dl>
  </div>
{%- else %}
  <div slot="navigation" class="wa-stack wa-gap-l">
    <nav class="wa-stack wa-gap-xs">
      <span class="wa-caption-s">Captures</span>
    {%- for view in collections.views %}{% if view.data.order == 1 %}
      <a href="{{ view.url }}" data-drawer="close">{{ view.data.capture.title }}</a>
    {%- endif %}{% endfor %}
    </nav>
    <nav class="wa-stack wa-gap-xs">
      <span class="wa-caption-s">Docs</span>
    {%- for doc in collections.doc %}
      <a href="{{ doc.url }}" data-drawer="close"{% if doc.url == page.url %} aria-current="page"{% endif %}>{{ doc.data.title }}</a>
    {%- endfor %}
    </nav>
  </div>
{%- endif %}

  <main>
{{ content }}
  </main>
</wa-page>
</body>
</html>
