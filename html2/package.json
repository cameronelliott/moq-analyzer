{
  "name": "html2",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bunx @11ty/eleventy",
    "dev": "bunx @11ty/eleventy --serve",
    "build:js": "bun build site/app.js site/app-live.js --outdir=dist --splitting --format=esm --production --sourcemap=linked",
    "build:css": "bun build site/app.css --outdir=dist --minify",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1 --directory dist"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@lit-labs/eleventy-plugin-lit": "1.0.6",
    "@lit-labs/ssr-client": "1.1.8",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.13.0",
    "lit": "3.3.3",
    "marked": "18.0.14"
  },
  "overrides": {
    "marked": "18.0.14"
  }
}
